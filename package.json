{
  "name": "agent-sh",
  "version": "0.13.0",
  "description": "A shell-first terminal where AI is one keystroke away",
  "type": "module",
  "main": "dist/core/index.js",
  "types": "dist/core/index.d.ts",
  "bin": {
    "agent-sh": "dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./utils/*": "./dist/utils/*",
    "./types": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./settings": {
      "types": "./dist/core/settings.d.ts",
      "default": "./dist/core/settings.js"
    },
    "./extension-loader": {
      "types": "./dist/core/extension-loader.d.ts",
      "default": "./dist/core/extension-loader.js"
    },
    "./extensions": {
      "types": "./dist/extensions/index.d.ts",
      "default": "./dist/extensions/index.js"
    },
    "./shell": {
      "types": "./dist/shell/shell.d.ts",
      "default": "./dist/shell/shell.js"
    },
    "./utils/stream-transform": {
      "types": "./dist/utils/stream-transform.d.ts",
      "default": "./dist/utils/stream-transform.js"
    },
    "./utils/terminal-buffer": {
      "types": "./dist/utils/terminal-buffer.d.ts",
      "default": "./dist/utils/terminal-buffer.js"
    },
    "./agent": {
      "types": "./dist/agent/index.d.ts",
      "default": "./dist/agent/index.js"
    },
    "./agent/types": {
      "types": "./dist/agent/types.d.ts",
      "default": "./dist/agent/types.js"
    },
    "./agent/subagent": {
      "types": "./dist/agent/subagent.d.ts",
      "default": "./dist/agent/subagent.js"
    },
    "./agent/agent-loop": {
      "types": "./dist/agent/agent-loop.d.ts",
      "default": "./dist/agent/agent-loop.js"
    },
    "./event-bus": {
      "types": "./dist/core/event-bus.d.ts",
      "default": "./dist/core/event-bus.js"
    },
    "./utils/compositor": {
      "types": "./dist/utils/compositor.d.ts",
      "default": "./dist/utils/compositor.js"
    },
    "./utils/floating-panel": {
      "types": "./dist/utils/floating-panel.d.ts",
      "default": "./dist/utils/floating-panel.js"
    },
    "./agent/token-budget": {
      "types": "./dist/agent/token-budget.d.ts",
      "default": "./dist/agent/token-budget.js"
    },
    "./agent/history-file": {
      "types": "./dist/agent/history-file.d.ts",
      "default": "./dist/agent/history-file.js"
    },
    "./agent/nuclear-form": {
      "types": "./dist/agent/nuclear-form.d.ts",
      "default": "./dist/agent/nuclear-form.js"
    },
    "./executor": {
      "types": "./dist/utils/executor.d.ts",
      "default": "./dist/utils/executor.js"
    },
    "./cli/install": {
      "types": "./dist/cli/install.d.ts",
      "default": "./dist/cli/install.js"
    },
    "./cli/init": {
      "types": "./dist/cli/init.d.ts",
      "default": "./dist/cli/init.js"
    },
    "./cli/auth": {
      "types": "./dist/cli/auth/cli.d.ts",
      "default": "./dist/cli/auth/cli.js"
    }
  },
  "files": [
    "dist",
    "examples/extensions/*.ts",
    "examples/extensions/*/package.json",
    "examples/extensions/*/tsconfig.json",
    "examples/extensions/*/README.md",
    "examples/extensions/*/src/**",
    "examples/extensions/*/index.ts",
    "examples/extensions/*/index.js"
  ],
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "build": "tsc",
    "start": "node dist/cli/index.js",
    "prepare": "test -d dist || npm run build"
  },
  "keywords": [
    "terminal",
    "shell",
    "agent",
    "ai",
    "acp",
    "cli",
    "pty",
    "llm"
  ],
  "author": "Yilun Guan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guanyilun/agent-sh.git"
  },
  "homepage": "https://github.com/guanyilun/agent-sh",
  "bugs": {
    "url": "https://github.com/guanyilun/agent-sh/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@vscode/ripgrep": "^1.17.1",
    "@xterm/addon-serialize": "^0.13.0",
    "@xterm/headless": "^5.5.0",
    "cli-highlight": "^2.1.11",
    "diff": "^9.0.0",
    "marked": "^17.0.6",
    "node-pty": "^1.2.0-beta.12",
    "openai": "^6.34.0",
    "string-width": "^8.2.0",
    "strip-ansi": "^7.2.0",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/diff": "^8.0.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
