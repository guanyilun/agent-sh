{
  "name": "ashi-ink",
  "version": "0.1.0",
  "description": "An Ink (React) renderer for ashi — registers ashi:renderer:ink, selected with ASHI_RENDERER=ink. Demonstrates that ashi's TUI is a swappable renderer behind an extension.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc",
    "test": "FORCE_COLOR=3 node --import tsx --test $(find test -name '*.test.tsx' -type f)"
  },
  "dependencies": {
    "@earendil-works/pi-tui": "^0.74.0",
    "@guanyilun/ashi": "^0.2.0",
    "agent-sh": "^0.14.0",
    "cli-table3": "^0.6.0",
    "ink": "^5.0.0",
    "ink-spinner": "^5.0.0",
    "marked": "^12.0.0",
    "marked-terminal": "^7.0.0",
    "react": "^18.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.7.0"
  }
}
